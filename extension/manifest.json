{
  "manifest_version": 3,
  "name": "Send to Scribe",
  "version": "0.2.0",
  "description": "Paste article links (Substack and more) and send them to your Kindle as EPUB via Gmail.",
  "key": "",
  "permissions": ["identity", "storage", "offscreen", "activeTab", "contextMenus", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://docs.upliftedconsulting.com/*", "http://localhost:8787/*", "http://127.0.0.1:8787/*"],
      "js": ["up-docs.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Send to Scribe" },
  "oauth2": {
    "client_id": "557324876827-5tu6ospq8ugs4u1o7hu4d3gp1dmn1v6h.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.send"]
  }
}
